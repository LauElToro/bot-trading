# Toro notifier — environment
#
# PostgreSQL database. NOTIFIER_DATABASE_URL takes precedence over DATABASE_URL.
# Use a dedicated read-only role in production.
NOTIFIER_DATABASE_URL=postgresql://notifier_ro:password@host:5432/grvt?sslmode=require

# Telegram credentials. Get the bot token from @BotFather, then send any
# message to your bot and grab your chat_id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Operator user id (UUIDv4). Only alerts owned by this user are forwarded
# to TELEGRAM_CHAT_ID. Leave empty to disable Telegram forwarding.
OPERATOR_USER_ID=

# Tunables
NOTIFIER_POLL_MS=10000              # how often to check for new events
NOTIFY_DRAWDOWN_PCT=15              # alert when drawdown from HWM > this %
NOTIFY_FILL_BATCH=5                 # batch fills into one message
DAILY_SUMMARY_HOUR_UTC=0            # 0..23, 24 to disable

# State directory (where the cursor JSON lives)
NOTIFIER_STATE_DIR=/var/lib/grvt-grid-notifier

# Email notifications (F.5). Same Gmail/SMTP vars as the bot.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Log level (debug | info | warn | error)
LOG_LEVEL=info
