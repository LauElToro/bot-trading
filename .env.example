# Toro — self-host environment.
#
# Copy this file to .env and fill in. NEVER commit .env to git.

# ─── PostgreSQL ────────────────────────────────────────────────────────
# External PostgreSQL connection. TLS is normally required by managed
# providers. The notifier should use a separate read-only role when enabled.
DATABASE_URL=postgresql://user:password@host:5432/grvt?sslmode=require
NOTIFIER_DATABASE_URL=
# 32 random bytes in base64: openssl rand -base64 32
CREDENTIAL_MASTER_KEY=

# ─── GRVT credentials ───────────────────────────────────────────────────
# Generate from your GRVT account UI.
# Referral: https://grvt.io/?ref=5LBBEMJ
GRVT_API_KEY=
GRVT_API_SECRET=0x...
GRVT_TRADING_ACCOUNT_ID=
GRVT_TRADING_ADDRESS=0x...

# Optional: separate funding (vault) account credentials
GRVT_FUNDING_API_KEY=
GRVT_FUNDING_API_SECRET=
GRVT_FUNDING_WALLET_ADDRESS=

# ─── Owner bootstrap (first boot) ──────────────────────────────────────
# Creates the first admin (UUIDv4 id) if the users table is empty. Remove
# OWNER_INITIAL_PASSWORD after the first login.
OWNER_EMAIL=
OWNER_INITIAL_PASSWORD=

# ─── Dashboard ─────────────────────────────────────────────────────────
# 32+ char random hex. Generate with:  openssl rand -hex 32
DASHBOARD_API_KEY=

# Bind port on the host. Keep it private when using an external reverse proxy.
BOT_PORT=3848

# ─── JWT (access + refresh) ─────────────────────────────────────────
# Prefer these two secrets. JWT_SECRET remains a fallback for older installs.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=7200
REFRESH_TOKEN_TTL_SECONDS=1209600
JWT_SECRET=

# ─── Auth gates ─────────────────────────────────────────────────────
# Email that becomes admin on signup. Leave blank to disable auto-admin.
ADMIN_EMAIL=
# Set to 1 to refuse new signups (email + Google).
SIGNUP_DISABLED=
# Set to 1 to accept X-Api-Key as the first admin user. Off in production.
ALLOW_LEGACY_API_KEY=

# ─── Google Sign-In ─────────────────────────────────────────────────
# GIS ID-token verify. No client secret. Add the dashboard origin
# (localhost + Vercel URL) under Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# ─── SMTP / Gmail (OTP login, email verification, resets + alerts) ──
# Gmail aliases map onto SMTP if SMTP_HOST is blank (smtp.gmail.com).
# Use a Google App Password, not the account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# Comma-separated origins of the hosted dashboard (Vercel). Enables CORS
# so the SPA can call this API from another origin. Leave blank when the
# dashboard is served from the same host as the bot.
DASHBOARD_ORIGIN=

# Public URL of the dashboard. Required to build password-reset links.
# Must be a full scheme+host with no trailing slash.
# The server does NOT derive this from the Host header.
APP_BASE_URL=

# ─── Metrics / CSP ──────────────────────────────────────────────────
# Remote scrapers must send Authorization: Bearer <token> (min 16 chars).
# Without this, /api/v2/metrics is localhost-only.
METRICS_TOKEN=
# CSP is on by default. Set 0 only for local debugging.
ENABLE_CSP=

# ─── Notifier (optional) ───────────────────────────────────────────────
# Get TELEGRAM_BOT_TOKEN from @BotFather, then send any message to your bot
# and grab your chat id from
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_DRAWDOWN_PCT=15
NOTIFY_FILL_BATCH=5
DAILY_SUMMARY_HOUR_UTC=0

# ─── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=info
