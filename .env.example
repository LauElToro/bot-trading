# Toro — self-host environment.
#
# Copy this file to .env and fill in. NEVER commit .env to git.
# (It's covered by .gitignore.)
#
# ─── GRVT credentials ───────────────────────────────────────────────────
# Generate from your GRVT account UI.
# Referral: https://grvt.io/?ref=5LBBEMJ
GRVT_API_KEY=
GRVT_API_SECRET=0x...
GRVT_TRADING_ACCOUNT_ID=
GRVT_TRADING_ADDRESS=0x...

# Optional: separate funding (vault) account credentials
GRVT_FUNDING_API_KEY=
GRVT_FUNDING_API_SECRET=
GRVT_FUNDING_WALLET_ADDRESS=

# ─── Dashboard ─────────────────────────────────────────────────────────
# 32+ char random hex. Generate with:  openssl rand -hex 32
DASHBOARD_API_KEY=

# Legacy basic auth for the v1 dashboard (still mounted at /).
# Remove these once you've migrated fully to the v2 dashboard at /dashboard/.
DASHBOARD_USER=admin
DASHBOARD_PASS=change-me

# Bind port on the host. With caddy, you can leave this and only expose 80/443.
BOT_PORT=3848

# ─── JWT (access + refresh) ─────────────────────────────────────────
# Prefer these two secrets. JWT_SECRET remains a fallback for older installs.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=7200
REFRESH_TOKEN_TTL_SECONDS=1209600
JWT_SECRET=

# ─── Google Sign-In ─────────────────────────────────────────────────
# GIS ID-token verify. No client secret. Add the dashboard origin
# (localhost + Vercel URL) under Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# ─── SMTP / Gmail (password reset + notification emails) ────────────
# Gmail aliases map onto SMTP if SMTP_HOST is blank (smtp.gmail.com).
# Use a Google App Password, not the account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# Comma-separated origins of the hosted dashboard (Vercel). Enables CORS
# so the SPA can call this API from another origin. Leave blank when the
# dashboard is served from the same host as the bot.
DASHBOARD_ORIGIN=

# Public URL of the dashboard. Used to build absolute links inside emails
# (e.g. https://grvt-grid.example.com/dashboard/reset-password?token=...).
# Leave blank to derive from the request host (only correct if you do not
# sit behind a reverse proxy that rewrites the Host header).
APP_BASE_URL=

# ─── Notifier (optional) ───────────────────────────────────────────────
# Get TELEGRAM_BOT_TOKEN from @BotFather, then send any message to your bot
# and grab your chat id from
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_DRAWDOWN_PCT=15
NOTIFY_FILL_BATCH=5
DAILY_SUMMARY_HOUR_UTC=0

# ─── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=info
